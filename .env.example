# Copy to .env and fill in real values.

PORT=5002

# MongoDB Atlas connection string
MONGODB_URI=

# Secret used to sign auth tokens (any long random string).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Admin portal credentials
ADMIN_USERNAME=
ADMIN_PASSWORD=

# When true, only signed tokens are trusted (the legacy x-user-role header is
# rejected). Turn on after all clients run the token-aware frontend build.
STRICT_AUTH=false
